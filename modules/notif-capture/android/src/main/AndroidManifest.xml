<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <service
      android:name="expo.modules.notifcapture.BankNotificationListener"
      android:label="GastoAuto"
      android:exported="true"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <provider
      android:name="expo.modules.notifcapture.CrashCatcher"
      android:authorities="${applicationId}.crashcatcher"
      android:exported="false"
      android:initOrder="1000" />
    <activity
      android:name="expo.modules.notifcapture.CrashActivity"
      android:process=":crash"
      android:exported="false"
      android:theme="@android:style/Theme.Material" />
  </application>
</manifest>
